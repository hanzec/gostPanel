      {"id": "tls_server_cert_file", "label": "出口证书文件", "kind": "file", "listener": "tls:certFile", "placeholder": "/etc/gost/server.crt", "help": "填写出口节点上的绝对路径。"},
      {"id": "tls_server_key_file", "label": "出口私钥文件", "kind": "file", "listener": "tls:keyFile", "placeholder": "/etc/gost/server.key", "help": "填写出口节点上的绝对路径。"},
