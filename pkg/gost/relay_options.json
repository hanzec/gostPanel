      {"id": "host", "label": "握手域名", "kind": "text", "dialer": "host", "placeholder": "relay.example.com"}
    ],
    "tls": [
      {"id": "tls_server_name", "label": "TLS 服务端名称（SNI）", "kind": "text", "dialer": "tls:serverName", "placeholder": "relay.example.com", "help": "用于入口到出口的 TLS 握手。"},
