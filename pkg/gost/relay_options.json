      {"id": "max_streams", "label": "QUIC 最大并发流数", "kind": "integer", "listener": "maxStreams", "dialer": "maxStreams", "min": 1, "max": 2147483647, "placeholder": "100"}
    ],
    "quic": [
      {"id": "quic_keepalive", "label": "QUIC 保活", "kind": "boolean", "listener": "keepAlive", "dialer": "keepAlive"},
      {"id": "quic_keepalive_period", "label": "QUIC 保活间隔", "kind": "duration", "listener": "ttl", "dialer": "ttl", "placeholder": "10s"},
      {"id": "quic_datagrams", "label": "启用 QUIC Datagrams", "kind": "boolean", "listener": "quic.enableDatagram", "dialer": "quic.enableDatagram"},
      {"id": "quic_cipher_key", "label": "QUIC 封包密钥", "kind": "text", "listener": "cipherKey", "dialer": "cipherKey", "secret": true, "help": "使用 16、24 或 32 字节的 AES 密钥。"}
    ],
    "h3_keepalive": [
      {"id": "quic_keepalive", "label": "QUIC 保活", "kind": "boolean", "listener": "keepalive", "dialer": "keepalive"},
      {"id": "quic_keepalive_period", "label": "QUIC 保活间隔", "kind": "duration", "listener": "ttl", "dialer": "ttl", "placeholder": "10s"}
    ],
    "kcp": [
      {"id": "kcp_key", "label": "KCP 加密密钥", "kind": "text", "listener": "kcp.key", "dialer": "kcp.key", "secret": true},
      {"id": "kcp_cipher", "label": "KCP 加密算法", "kind": "select", "listener": "kcp.crypt", "dialer": "kcp.crypt", "choices": ["aes", "aes-128", "aes-192", "sm4", "salsa20", "twofish", "blowfish", "cast5", "3des", "tea", "xtea", "xor", "none"]},
      {"id": "kcp_mode", "label": "KCP 模式", "kind": "select", "listener": "kcp.mode", "dialer": "kcp.mode", "choices": ["normal", "fast", "fast2", "fast3", "manual"], "help": "预设模式会覆盖更新间隔、重传和拥塞控制。选择 manual 可自行设置。"},
      {"id": "kcp_keepalive", "label": "KCP 保活间隔（秒）", "kind": "integer", "listener": "kcp.keepalive", "dialer": "kcp.keepalive", "min": 1, "max": 65535},
      {"id": "kcp_interval", "label": "KCP 更新间隔（毫秒）", "kind": "integer", "listener": "kcp.interval", "dialer": "kcp.interval", "min": 10, "max": 5000},
