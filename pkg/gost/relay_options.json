      {"id": "kcp_receive_window", "label": "KCP 接收窗口", "kind": "integer", "listener": "kcp.rcvwnd", "dialer": "kcp.rcvwnd", "min": 1, "max": 65535},
      {"id": "kcp_send_window", "label": "KCP 发送窗口", "kind": "integer", "listener": "kcp.sndwnd", "dialer": "kcp.sndwnd", "min": 1, "max": 65535},
      {"id": "kcp_smux_version", "label": "KCP SMUX 版本", "kind": "select", "listener": "kcp.smuxver", "dialer": "kcp.smuxver", "choices": ["1", "2"]},
      {"id": "kcp_smux_buffer", "label": "KCP SMUX 缓冲区（字节）", "kind": "integer", "listener": "kcp.smuxbuf", "dialer": "kcp.smuxbuf", "min": 1, "max": 2147483647},
      {"id": "kcp_stream_buffer", "label": "KCP 单流缓冲区（字节）", "kind": "integer", "listener": "kcp.streambuf", "dialer": "kcp.streambuf", "min": 1, "max": 2147483647},
      {"id": "kcp_no_compression", "label": "禁用 KCP 压缩", "kind": "boolean", "listener": "kcp.nocomp", "dialer": "kcp.nocomp"},
      {"id": "kcp_data_shards", "label": "KCP FEC 数据分片", "kind": "integer", "listener": "kcp:datashard", "dialer": "kcp:datashard", "min": 0, "max": 255, "placeholder": "10"},
      {"id": "kcp_parity_shards", "label": "KCP FEC 校验分片", "kind": "integer", "listener": "kcp:parityshard", "dialer": "kcp:parityshard", "min": 0, "max": 255, "placeholder": "3"},
      {"id": "kcp_dscp", "label": "KCP DSCP", "kind": "integer", "listener": "kcp:dscp", "dialer": "kcp:dscp", "min": 0, "max": 63, "placeholder": "0"},
      {"id": "kcp_socket_buffer", "label": "KCP 套接字缓冲区（字节）", "kind": "integer", "listener": "kcp:sockbuf", "dialer": "kcp:sockbuf", "min": 1, "max": 2147483647, "placeholder": "4194304"},
      {"id": "kcp_ack_no_delay", "label": "KCP 立即发送 ACK", "kind": "boolean", "listener": "kcp:acknodelay", "dialer": "kcp:acknodelay"},
      {"id": "kcp_no_delay", "label": "KCP 低延迟模式", "kind": "integer", "listener": "kcp:nodelay", "dialer": "kcp:nodelay", "min": 0, "max": 1},
      {"id": "kcp_resend", "label": "KCP 快速重传阈值", "kind": "integer", "listener": "kcp:resend", "dialer": "kcp:resend", "min": 0, "max": 65535},
      {"id": "kcp_no_congestion", "label": "KCP 禁用拥塞控制", "kind": "integer", "listener": "kcp:nc", "dialer": "kcp:nc", "min": 0, "max": 1}
    ],
    "ohttp": [
      {"id": "path", "label": "HTTP 路径", "kind": "path", "dialer": "obfs.path", "placeholder": "/"},
      {"id": "host", "label": "HTTP Host", "kind": "text", "dialer": "obfs.host", "placeholder": "relay.example.com"},
      {"id": "request_headers", "label": "HTTP 请求头", "kind": "headers", "dialer": "obfs.header", "placeholder": "{\"X-Example\": \"value\"}"},
      {"id": "response_headers", "label": "HTTP 响应头", "kind": "headers", "listener": "header", "placeholder": "{\"X-Example\": \"value\"}"}
    ],
