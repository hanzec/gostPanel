      {"id": "tls_client_cert_file", "label": "入口客户端证书", "kind": "file", "dialer": "tls:certFile", "placeholder": "/etc/gost/client.crt", "help": "填写入口节点上的绝对路径。"},
      {"id": "tls_client_key_file", "label": "入口客户端私钥", "kind": "file", "dialer": "tls:keyFile", "placeholder": "/etc/gost/client.key", "help": "填写入口节点上的绝对路径。"},
